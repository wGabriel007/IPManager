@model projeto.ViewModels.CadastroViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <title>Cadastro – IPManager</title>
    <link rel="stylesheet" href="~/css/cadastro.css" asp-append-version="true" />
</head>
<body>
<div class="card">
    <h1>Criar Conta</h1>

    <form method="post" asp-action="Cadastro" asp-controller="Contas">
        @Html.AntiForgeryToken()
        <label>Nome</label>
        <input asp-for="Nome" placeholder="Seu nome" />
        <span asp-validation-for="Nome" class="erro"></span>

        <label>E-mail</label>
        <input asp-for="Email" type="email" placeholder="seuemail@exemplo.com" />
        <span asp-validation-for="Email" class="erro"></span>

        <label>Senha</label>
        <input asp-for="Senha" type="password" placeholder="Mínimo 6 caracteres" />
        <span asp-validation-for="Senha" class="erro"></span>

        <button type="submit">Cadastrar</button>
    </form>
    <a class="link" href="@Url.Action("Login","Contas")">Já tem conta? Entrar</a>
</div>
</body>
</html>
